---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import { profile } from '../data/resume';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${profile.name}｜個人履歷`,
  description = `${profile.name}的個人網站：履歷、作品集與文章。`,
} = Astro.props;
---

<!doctype html>
<html lang="zh-Hant">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+TC:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
    <!-- 在畫面繪製前套用深淺色，避免閃爍 -->
    <script is:inline>
      (() => {
        let t = null;
        try { t = localStorage.getItem('theme'); } catch (e) {}
        if (t === 'dark' || (!t && matchMedia('(prefers-color-scheme: dark)').matches)) {
          document.documentElement.classList.add('dark');
        }
      })();
    </script>
  </head>
  <body class="bg-stone-50 font-sans leading-relaxed text-stone-900 antialiased dark:bg-neutral-950 dark:text-neutral-100">
    <Nav />
    <main id="top">
      <slot />
    </main>
    <footer class="no-print py-10 text-center text-sm text-stone-500 dark:text-neutral-400">
      © {new Date().getFullYear()} {profile.name} · 以 Astro + Tailwind CSS 打造
    </footer>
  </body>
</html>
