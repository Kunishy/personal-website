---
import { getResume, type Lang, type TimelineItem } from '../data/resume';
import { t } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const { experience, education } = getResume(lang);
const ui = t(lang);

const panels = (
  [
    { key: 'experience', label: ui.tabs.experience, items: experience },
    { key: 'edu', label: ui.tabs.edu, items: education },
  ] satisfies { key: string; label: string; items: TimelineItem[] }[]
).filter((p) => p.items.length > 0);
---

<section id="experience" class="py-10">
  <div class="mx-auto max-w-5xl px-4">
    <div class="mb-5 flex flex-wrap items-center justify-between gap-3">
      <h2 class="text-2xl font-bold">{ui.experience}</h2>
      <div class="no-print inline-flex rounded-xl border border-paper-line bg-paper-card p-1 dark:border-neutral-800 dark:bg-neutral-900" role="tablist">
        {
          panels.map((p, i) => (
            <button
              data-tl-tab={p.key}
              role="tab"
              aria-selected={i === 0 ? 'true' : 'false'}
              class="rounded-lg px-3.5 py-1 text-sm text-stone-500 aria-selected:bg-blue-600 aria-selected:text-white dark:text-neutral-400 dark:aria-selected:bg-blue-500"
            >
              {p.label}
            </button>
          ))
        }
      </div>
    </div>

    {
      panels.map((p, i) => (
        <>
          <ol
            data-tl-panel={p.key}
            class:list={[{ 'screen-hidden': i !== 0 }, 'relative before:absolute before:top-2 before:bottom-2 before:left-[7px] before:w-0.5 before:bg-paper-line dark:before:bg-neutral-800']}
          >
            {p.items.map((item) => (
              <li class="relative mb-4 pl-9 before:absolute before:top-[22px] before:left-0 before:size-4 before:rounded-full before:border-[3px] before:border-blue-600 before:bg-paper-card dark:before:border-blue-400 dark:before:bg-neutral-950">
                <div class="card px-5 py-4">
                <div class="flex flex-wrap justify-between gap-x-3 gap-y-1">
                  <h3 class="text-[1.0625rem] font-bold">{item.title}</h3>
                  {item.date && <span class="text-sm whitespace-nowrap text-stone-500 dark:text-neutral-400">{item.date}</span>}
                </div>
                <p class="mt-0.5 text-[0.9375rem] text-blue-600 dark:text-blue-400">{item.org}</p>
                {item.points.length > 0 && (
                  <ul class="mt-2 list-disc pl-5 text-[0.9375rem] whitespace-pre-line text-stone-600 dark:text-neutral-400">
                    {item.points.map((pt) => <li>{pt}</li>)}
                  </ul>
                )}
                </div>
              </li>
            ))}
          </ol>
        </>
      ))
    }
  </div>
</section>

<script>
  const tabs = document.querySelectorAll<HTMLButtonElement>('[data-tl-tab]');
  const panels = document.querySelectorAll<HTMLElement>('[data-tl-panel]');
  tabs.forEach((tab) =>
    tab.addEventListener('click', () => {
      tabs.forEach((t) => t.setAttribute('aria-selected', String(t === tab)));
      panels.forEach((p) => p.classList.toggle('screen-hidden', p.dataset.tlPanel !== tab.dataset.tlTab));
    }),
  );
</script>
