---
// 首頁內容（中文 / 和英文 /en/ 共用）
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Hero from './Hero.astro';
import Timeline from './Timeline.astro';
import Skills from './Skills.astro';
import Projects from './Projects.astro';
import PostList from './PostList.astro';
import Contact from './Contact.astro';
import PrintResume from './PrintResume.astro';
import type { Lang } from '../data/resume';
import { t } from '../i18n';
import { url } from '../utils';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const ui = t(lang);

// 部落格目前只有中文
const posts =
  lang === 'zh'
    ? (await getCollection('blog', ({ data }) => !data.draft))
        .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
        .slice(0, 3)
    : [];
---

<Base lang={lang} alternates>
  <Hero lang={lang} />
  <Timeline lang={lang} />
  <Skills lang={lang} />
  <Projects lang={lang} />
  {
    posts.length > 0 && (
      <section id="blog" class="no-print py-10">
        <div class="mx-auto max-w-5xl px-4">
          <div class="mb-5 flex items-baseline justify-between gap-3">
            <h2 class="text-2xl font-bold">{ui.latestPosts}</h2>
            <a class="text-sm text-blue-600 hover:underline dark:text-blue-400" href={url('blog/')}>
              {ui.allPosts}
            </a>
          </div>
          <PostList posts={posts} />
        </div>
      </section>
    )
  }
  <Contact lang={lang} />
  <PrintResume lang={lang} slot="print" />
</Base>
