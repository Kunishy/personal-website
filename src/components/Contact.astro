---
import { getResume, type Lang } from '../data/resume';
import { t } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const { profile } = getResume(lang);
const ui = t(lang);
---

<section id="contact" class="no-print py-10">
  <div class="mx-auto max-w-5xl px-4">
    <div class="card p-7 text-center">
      <h2 class="mb-2 text-2xl font-bold">{ui.contactTitle}</h2>
      <p class="mb-5 text-stone-600 dark:text-neutral-400">{ui.contactText}</p>
      <div class="flex flex-wrap justify-center gap-2.5">
        <a class="btn btn-primary" href={`mailto:${profile.email}`}>{ui.emailMe}</a>
        {profile.links.github && <a class="btn" href={profile.links.github} target="_blank" rel="noopener">GitHub</a>}
        {profile.links.linkedin && <a class="btn" href={profile.links.linkedin} target="_blank" rel="noopener">LinkedIn</a>}
      </div>
    </div>
  </div>
</section>
