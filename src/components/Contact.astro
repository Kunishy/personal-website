---
import { profile } from '../data/resume';
---

<section id="contact" class="no-print py-10">
  <div class="mx-auto max-w-5xl px-4">
    <div class="card p-7 text-center">
      <h2 class="mb-2 text-2xl font-bold">一起合作吧</h2>
      <p class="mb-5 text-stone-600 dark:text-neutral-400">歡迎實習、專案合作或研究交流的邀約。</p>
      <div class="flex flex-wrap justify-center gap-2.5">
        <a class="btn btn-primary" href={`mailto:${profile.email}`}>寄信給我</a>
        {profile.links.github && <a class="btn" href={profile.links.github} target="_blank" rel="noopener">GitHub</a>}
        {profile.links.linkedin && <a class="btn" href={profile.links.linkedin} target="_blank" rel="noopener">LinkedIn</a>}
      </div>
    </div>
  </div>
</section>
